{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"outDir": "dist",
		"rootDir": ".",
		"paths": {
			"@/*": ["./app/*"]
		}
	},
	"include": ["app"],
	"exclude": ["node_modules", "dist"]
}
